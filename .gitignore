# Credentials
config.json
backtest_config.json

# OHLCV data files (large, fetched at runtime)
data/ohlcv/*.json
# But track the fetch log
!data/ohlcv/_fetch_log.json

# Backtest run outputs (generated, can be large)
data/runs/*/trade_log.jsonl
data/runs/*/daily_portfolio.jsonl
data/runs/*/summary.json

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.venv/
venv/

# Android (live_deploy/android/) — build outputs, per-machine local
# config, and the Gradle wrapper jar (a binary this repo doesn't commit;
# see android/README.md's own "Getting it running" step 2 for why —
# Android Studio/`gradle wrapper` regenerates it on first sync).
live_deploy/android/local.properties
live_deploy/android/**/build/
live_deploy/android/.gradle/
live_deploy/android/.idea/
live_deploy/android/**/*.iml
live_deploy/android/gradle/wrapper/gradle-wrapper.jar
live_deploy/android/captures/
live_deploy/android/.cxx/
