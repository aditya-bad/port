# Credentials — never commit these
config.json

# custom_scripts/ output -- real market-data seed dumps
# (register_supertrend_options_strategies.py's own JSON output), not
# something that belongs in git history every time it's re-run.
custom_scripts/data/

# Python
__pycache__/
*.pyc

# supervisord.conf's own runtime output (see RUN_GUIDE.md) — keep the
# directory (so supervisord doesn't need to create it first) but not
# its generated logs/sockets/pidfile.
logs/*
!logs/.gitkeep
