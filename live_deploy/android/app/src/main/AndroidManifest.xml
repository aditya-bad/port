<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No notification permission requested yet on purpose — this build
         has no notification code at all (Chrome/the PWA's own Web Push
         stays the notification channel for now, see the app README's
         "Notifications" section). Add POST_NOTIFICATIONS (API 33+) when
         that's actually built, not before — an unused runtime permission
         prompt with nothing behind it is worse than not asking at all. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".LiveDeployApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.LiveDeploy"
        android:usesCleartextTraffic="true">
        <!-- usesCleartextTraffic=true: a Tailscale-served instance (the
             deployment shape this app's own backend README recommends,
             see RUN_GUIDE.md) is reached over plain HTTP on a WireGuard-
             encrypted tailnet address, same reasoning HostAwareSession
             Middleware's own _LOCALHOST_HOSTS/tailnet-range comment gives
             for not setting a Secure cookie flag there. A caller pointed
             at a real public HTTPS host is unaffected either way — this
             only widens what's ALLOWED, never blocks HTTPS. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.LiveDeploy"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- P&L home-screen widget (Glance) — see widget/PnlWidget.kt -->
        <receiver
            android:name=".widget.PnlWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_pnl_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pnl_widget_info" />
        </receiver>
    </application>

</manifest>
